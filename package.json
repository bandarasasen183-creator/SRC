  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.26.0",
    "playwright": "^1.62.1"
  },
  "private": true,
  "type": "module",
  "dependencies": {
